{% doc %}
  @prompt
    Create a single Holiday Gift Sets promotional card for the separate all-products collection template only. Match the existing product cards: portrait photo, square corners, no decorative border or shadow, a full-width olive-green button attached directly beneath the photo with white serif text, and a centered serif title below reading Holiday Gift Sets. Button text: Shop Holiday Gift Sets. Provide editable image and collection destination pickers, with destination Holiday Gift Sets collection gid://shopify/Collection/642291335327. Both photo and button should link to that collection, not add anything to cart. Match the width of one card in the existing four-column desktop and two-column mobile product grid, including spacing and typography. Prefer placement alongside existing products if supported; do not claim in-grid placement or modify the existing product grid if this generated block cannot support it. Otherwise keep the card in its own row at matching card width, not a wide banner. Make image, title, button text, and link editable. Do not create dummy products, display a price, add individual gift-set products, change the default collection template, or affect other collections. Leave the image picker empty until the merchant selects a real holiday photo. Preserve all existing page content., Center the entire Holiday Gift Sets card horizontally within its section on mobile and desktop, with equal left and right spacing. Keep its current width, image, button, text, and link unchanged. Center the whole card, not just the text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holiday-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    color: #4f5e3c;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .ai-holiday-card-{{ ai_gen_id }}__media {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .ai-holiday-card-{{ ai_gen_id }}__image,
  .ai-holiday-card-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-holiday-card-{{ ai_gen_id }}__placeholder {
    background: #f1eddf;
  }

  .ai-holiday-card-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #4f5e3c;
  }

  .ai-holiday-card-{{ ai_gen_id }}__button {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 12px 8px;
    border: 0;
    border-radius: 0;
    background: #4f5e3c;
    color: #ffffff;
    font: inherit;
    font-size: 16px;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
  }

  .ai-holiday-card-{{ ai_gen_id }}__button:hover {
    background: #3b482d;
    color: #ffffff;
  }

  .ai-holiday-card-{{ ai_gen_id }}__button:focus-visible,
  .ai-holiday-card-{{ ai_gen_id }}__media:focus-visible {
    outline: 2px solid #4f5e3c;
    outline-offset: 3px;
  }

  .ai-holiday-card-{{ ai_gen_id }}__title {
    margin: 12px 0 0;
    color: #4f5e3c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-holiday-card-{{ ai_gen_id }}__button {
      font-size: 14px;
      min-height: 44px;
    }
    .ai-holiday-card-{{ ai_gen_id }}__title {
      font-size: 16px;
    }
  }
{% endstyle %}

<div class="ai-holiday-card-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.destination != blank %}
    <a class="ai-holiday-card-{{ ai_gen_id }}__media" href="{{ block.settings.destination.url }}" aria-label="{{ block.settings.card_title | escape }}">
      {% if block.settings.image != blank %}
        <img class="ai-holiday-card-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | default: block.settings.card_title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-holiday-card-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </a>
    <a class="ai-holiday-card-{{ ai_gen_id }}__button" href="{{ block.settings.destination.url }}">{{ block.settings.button_text | escape }}</a>
  {% else %}
    <div class="ai-holiday-card-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img class="ai-holiday-card-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | default: block.settings.card_title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-holiday-card-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>
    <span class="ai-holiday-card-{{ ai_gen_id }}__button">{{ block.settings.button_text | escape }}</span>
  {% endif %}
  <h2 class="ai-holiday-card-{{ ai_gen_id }}__title">{{ block.settings.card_title | escape }}</h2>
</div>

{% schema %}
{
  "name": "Holiday gift card",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "collection",
      "id": "destination",
      "label": "Destination collection"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Title",
      "default": "Holiday Gift Sets"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Holiday Gift Sets"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Holiday gift card"
    }
  ],
  "tag": null,
  "class": "holiday-gift-card"
}
{% endschema %}